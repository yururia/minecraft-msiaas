{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm --filter @msiaas/web build",
    "devPath": "http://localhost:3000",
    "distDir": "../../web/out",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Minecraft MSIaaS",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": false,
        "sidecar": false
      },
      "fs": {
        "all": false,
        "scope": ["$APPDATA/msiaas/**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.msiaas.client",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": []
    },
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: http: https: ws: wss:; connect-src 'self' http://localhost:3000 http://localhost:8787 http://127.0.0.1:* ws://127.0.0.1:* https://*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: http: https:; media-src 'self' data: blob:; frame-src 'self';"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Minecraft MSIaaS",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 520
      }
    ]
  }
}
